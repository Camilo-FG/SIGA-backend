# --- Database -------------------------------------------------------------
# PostgreSQL connection string.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/siga?schema=public"

# --- Authentication -------------------------------------------------------
# Use a long random string in every environment: openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string"
# Access token lifetime in seconds (86400 = 24 hours).
JWT_EXPIRES_IN=86400

# --- HTTP -----------------------------------------------------------------
PORT=3000
# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:5173

# --- One-time bootstrap -----------------------------------------------------
# Required only when running npm run prisma:seed:admin on an empty database.
# Remove these variables after the initial administrator has been created.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_NAME=SIGA Administrator
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-password
