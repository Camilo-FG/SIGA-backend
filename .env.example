# --- Database -------------------------------------------------------------
# PostgreSQL connection string.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/siga?schema=public"

# --- Authentication -------------------------------------------------------
# Use a long random string in every environment: openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string"
# Access token lifetime in seconds (86400 = 24 hours).
JWT_EXPIRES_IN=86400

# --- HTTP -----------------------------------------------------------------
PORT=3000
# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:5173
